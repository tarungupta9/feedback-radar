# Server-only. Set locally in .env.local and in Vercel environment settings.
# Not needed to build or view the starter page.
TYPESAFE_API_KEY=

# Server-only protection settings. Required for analysis, not builds or uploads.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate at least 32 random characters. Keep stable across production deployments.
RATE_LIMIT_IDENTITY_SECRET=
# Use production-feedback-radar / preview-feedback-radar on Vercel.
RATE_LIMIT_NAMESPACE=development-feedback-radar
# Required: choose from your AI budget and conservative per-attempt cost.
RATE_LIMIT_GLOBAL_DAILY=
ANALYSIS_ENABLED=true
RATE_LIMIT_BURST=20
RATE_LIMIT_REFILL_PER_SECOND=2
RATE_LIMIT_IP_DAILY=500
RATE_LIMIT_IP_ACTIVE=6
RATE_LIMIT_GLOBAL_ACTIVE=20
# Only accepted in development at loopback URLs, outside Vercel. Quotas still apply.
RATE_LIMIT_LOCAL_IDENTITY=false
